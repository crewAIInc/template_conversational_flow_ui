# Automation deployment base URL from its CrewAI AMP Status tab.
# Do not append /chat or /kickoff.
CREWAI_AMP_URL=https://your-flow-url.crewai.com

# Bearer token for this deployment, without the "Bearer " prefix.
# Keep the real value in .env or server environment variables.
CREWAI_BEARER_TOKEN="replace-with-your-deployment-bearer-token"

# Optional local server port. Open http://localhost:<PORT> if changed.
# PORT=5173
